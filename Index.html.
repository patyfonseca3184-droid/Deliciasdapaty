var isG=function(f){return f.some(function(s){return G.indexOf(s)>-1})};var perKg=function(i){return !isG(i.f)&&i.w>2?65:70};var decV=function(i){return i.d==='s'?20:0};var decT=function(i){return i.m+' · '+(i.d==='s'?'Decoração tema personalizado'+(i.t?' ('+i.t+')':'')+' (+R$ 20,00)':'Sem decoração')};var cakeV=function(i){return perKg(i)*i.w+decV(i)};
$('mq').innerHTML=Array(2).fill(T.concat(G).slice(0,14).join(' ✦ ')+' ✦ ').join('');
var tabs=[['b','Bolos'],['d','Doces']];
function drawTabs(){$('tabs').innerHTML=tabs.map(function(t){return '<button class="tab'+(kind===t[0]?' on':'')+'" data-k="'+t[0]+'">'+t[1]+'</button>'}).join('');
 [].forEach.call($('tabs').children,function(b){b.onclick=function(){kind=b.dataset.k;sel=[];drawTabs();drawCake()}})}
function drawCake(){var d=kind==='d';$('cakeBox').style.display=d?'none':'block';$('docBox').style.display=d?'block':'none';
 if(d){drawDocs();return}
 $('cakePrice').textContent='Tradicionais R$ 70,00/kg (acima de 2 kg, R$ 65,00/kg) · Gourmet R$ 70,00/kg';
 $('kgHint').textContent='Com algum sabor gourmet, o quilo é R$ 70';
 var chip=function(s){return '<button class="chip'+(sel.indexOf(s)>-1?' on':'')+'">'+s+'</button>'};$('chips').innerHTML='<div class="gt">Tradicionais</div>'+T.map(chip).join('')+'<div class="gt">Gourmet</div>'+G.map(chip).join('');
 [].forEach.call($('chips').querySelectorAll('.chip'),function(c){c.onclick=function(){var s=c.textContent,i=sel.indexOf(s);if(i>-1)sel.splice(i,1);else{if(sel.length>=2){$('cakeNote').textContent='Máximo de 2 sabores por bolo.';return}sel.push(s)}$('cakeNote').textContent=sel.length?sel.join(' + '):'Escolha até 2 sabores.';drawCake()}})}
function drawDocs(){$('docBox').innerHTML=D.map(function(g){return '<div class="price">'+g.n+' · '+money(g.p)+' o cento</div>'+g.l.map(function(n){var q=dq[n]||0;return '<div class="row"><span>'+n+'<small>'+(q?q+' unidades · '+money(q*g.p/100):'a partir de '+(MIN[n]||25)+' unidades')+'</small></span><div class="step"><button data-n="'+n+'" data-d="-25">−</button><b>'+q+'</b><button data-n="'+n+'" data-d="25">+</button></div></div>'}).join('')}).join('')+'<p class="note">Vendidos por cento. Ajuste de 25 em 25 unidades. Olhos verdes: mínimo de 50 unidades.</p>';
 [].forEach.call($('docBox').querySelectorAll('.step button'),function(b){b.onclick=function(){var n=b.dataset.n;var c=dq[n]||0,mn=MIN[n]||25;dq[n]=Number(b.dataset.d)>0?(c?c+25:mn):(c-25<mn?0:c-25);drawDocs();render()}})}
$('kgm').onclick=function(){kg=Math.max(1,kg-.5);$('kgv').textContent=kg+' kg'};
$('kgp').onclick=function(){kg=Math.min(20,kg+.5);$('kgv').textContent=kg+' kg'};
$('addCake').onclick=function(){if(!sel.length){$('cakeNote').textContent='Escolha pelo menos 1 sabor.';return}
 items.push({f:sel.slice(),w:kg,m:$('massa').value,d:$('dec').value,t:$('tema').value.trim()});burst();sel=[];$('cakeNote').textContent='Bolo adicionado ao pedido.';drawCake();render()};
function price(){var t=0;items.forEach(function(i){t+=cakeV(i)});D.forEach(function(g){g.l.forEach(function(n){t+=(dq[n]||0)*g.p/100})});return t}
function render(){var h='';items.forEach(function(i,x){h+='<div class="row"><span>Bolo · '+i.w+' kg<small>'+i.f.join(' + ')+'<br>'+decT(i)+'</small></span><span>'+money(cakeV(i))+'<br><button class="rm" data-x="'+x+'">remover</button></span></div>'});
 D.forEach(function(g){g.l.forEach(function(n){if(dq[n])h+='<div class="row"><span>'+n+'<small>'+dq[n]+' unidades</small></span><span>'+money(dq[n]*g.p/100)+'</span></div>'})});
 $('list').innerHTML=h||'<p class="note">Seu pedido está vazio. Escolha acima o que vai levar para a mesa.</p>';
 [].forEach.call($('list').querySelectorAll('.rm'),function(b){b.onclick=function(){items.splice(b.dataset.x,1);render()}});
 var t=price();$('tot').textContent=money(t)+($('ent').value==='Entrega'?' + taxa de entrega':'');$('barTxt').textContent='Total '+money(t);$('bar').classList.toggle('on',t>0);upd()}
function mk(){
 var m=['Olá, Paty! Gostaria de fazer um pedido ✨',''];
 items.forEach(function(i){m.push('• Bolo '+i.w+' kg: '+i.f.join(' + ')+' ('+money(perKg(i)*i.w)+') · '+decT(i))});
 D.forEach(function(g){g.l.forEach(function(n){if(dq[n])m.push('• '+n+': '+dq[n]+' unidades ('+money(dq[n]*g.p/100)+')')})});
 m.push('','Total estimado: '+money(price()));
 if($('nome').value)m.push('Nome: '+$('nome').value);
 if($('data').value)m.push('Data desejada: '+$('data').value);
 m.push('Modalidade: '+$('ent').value);if($('ent').value==='Entrega'){m.push('Endereço para entrega: '+($('end').value||'(a informar)'));m.push('Por favor, confirme a taxa de entrega e a disponibilidade.')}
 if($('obs').value)m.push('Observações: '+$('obs').value);m.push('Pagamento: '+$('pay').value);var rd=refs.length?$('refd').value.trim():'';if(refs.length||rd){m.push('Referência: '+(refs.length?'vou enviar foto de inspiração aqui na conversa em seguida. ':'')+(rd?'Detalhes: '+rd:''))}
 MSG=m.join('\n');return 'https://api.whatsapp.com/send?phone='+WA+'&text='+encodeURIComponent(MSG)}
var MSG='';function upd(){if(price()>0)$('send').href=mk()}
$('send').onclick=function(e){if(price()<=0){e.preventDefault();$('list').innerHTML='<p class="note">Adicione ao menos um item antes de enviar.</p>';return}this.href=mk()};
// sprinkles
var hero=document.getElementById('top'),cs=['#ff9fd0','#fff3f9','#e5559f','#ffd1e8'];
for(var i=0;i<16;i++){var s=document.createElement('i');s.className='spr';s.style.cssText='left:'+Math.random()*100+'%;background:'+cs[i%4]+';animation-duration:'+(7+Math.random()*7)+'s;animation-delay:-'+Math.random()*10+'s';hero.appendChild(s)}
// reveal
var rv=document.querySelectorAll('.rv');
if('IntersectionObserver' in window){var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.12});rv.forEach(function(r){io.observe(r)})}else rv.forEach(function(r){r.classList.add('in')});
$('dec').onchange=function(){$('tema').style.display=this.value==='s'?'block':'none'};['nome','data','ent','obs','end','refd','pay'].forEach(function(id){$(id).addEventListener('input',upd);$(id).addEventListener('change',upd)});$('ent').addEventListener('change',function(){var d=this.value==='Entrega';$('end').style.display=d?'block':'none';$('entNote').style.display=d?'block':'none';render()});$('cp').onclick=function(){if(price()<=0)return;mk();var ta=document.createElement('textarea');ta.value=MSG;document.body.appendChild(ta);ta.select();try{document.execCommand('copy')}catch(e){}ta.remove();$('cp').textContent='Pedido copiado! Cole na conversa do WhatsApp.'};
function burst(){var b=$('addCake'),r=b.getBoundingClientRect(),em=['✨','🍒','💖','🍰'];for(var i=0;i<14;i++){var s=document.createElement('i');s.className='bp';s.textContent=em[i%4];s.style.left=(r.left+r.width/2)+'px';s.style.top=(r.top+r.height/2)+'px';s.style.setProperty('--x',(Math.random()*240-120)+'px');s.style.setProperty('--y',(-Math.random()*170-30)+'px');document.body.appendChild(s);setTimeout(function(e){e.remove()}.bind(null,s),950)}}
document.querySelectorAll('.cnt').forEach(function(el){var n=+el.textContent;if(!('IntersectionObserver' in window))return;el.textContent='0';new IntersectionObserver(function(e,o){if(e[0].isIntersecting){o.disconnect();var t0=performance.now();(function f(t){var p=Math.min(1,(t-t0)/1200);el.textContent=Math.round(n*p);if(p<1)requestAnimationFrame(f)})(t0)}}).observe(el)});
var refs=[];$('foto').onchange=function(){var y=this.value==='s';refs=y?[1]:[];$('refd').style.display=y?'block':'none';$('refN').style.display=y?'block':'none';upd()};var _old=function(){refs=[].slice.call(this.files,0,5);$('prevs').innerHTML='';refs.forEach(function(f){var r=new FileReader();r.onload=function(){var im=document.createElement('img');im.src=r.result;im.alt='Referência';$('prevs').appendChild(im)};r.readAsDataURL(f)});$('upT').textContent=refs.length?'✅ '+refs.length+' foto(s) selecionada(s). Toque para trocar':'📷 Escolher fotos do bolo desejado';$('refN').style.display=refs.length?'block':'none';upd()};
drawTabs();drawCake();render();
</script>
